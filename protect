        font-size:22px;
        font-weight:700;
        line-height:1.35;
        color:#fff;
        margin:0 0 26px;
      }

      .vs-row {
        display:flex;
        align-items:center;
        justify-content:center;
        gap:14px;
        margin-bottom:8px;
      }

      .stance-pill {
        display:inline-flex;
        align-items:center;
        gap:8px;
        background:rgba(224,87,74,0.14);
        border:0.5px solid #e0574a;
        color:#fff;
        font-size:13px;
        font-weight:700;
        letter-spacing:0.3px;
        text-transform:uppercase;
        padding:9px 20px;
        border-radius:999px;
      }

      .stance-pill .dot {
        width:7px;
        height:7px;
        border-radius:50%;
        background:#e0574a;
        box-shadow:0 0 8px #e0574a;
      }

      .vs-label {
        font-size:11px;
        letter-spacing:1px;
        color:#555;
        font-weight:700;
      }

      .ai-side {
        font-size:13px;
        color:#777;
        font-weight:600;
        padding:9px 20px;
        border:0.5px dashed #333;
        border-radius:999px;
      }

      .perforation {
        position:relative;
        height:0;
        border-top:1px dashed #2a2a2a;
        margin:0 32px;
      }

      .perforation::before,
      .perforation::after {
        content:"";
        position:absolute;
        top:-11px;
        width:22px;
        height:22px;
        background:#0f0f0f;
        border-radius:50%;
      }

      .perforation::before { left:-43px; }
      .perforation::after { right:-43px; }

      .ticket-bottom {
        padding:24px 32px 32px;
      }

      .meta-row {
        display:flex;
        justify-content:space-between;
        align-items:center;
        padding:12px 0;
        border-bottom:0.5px solid #212121;
      }

      .meta-row:last-of-type {
        border-bottom:none;
      }

      .meta-label {
        font-size:11px;
        text-transform:uppercase;
        letter-spacing:0.8px;
        color:#666;
      }

      .meta-value {
        font-size:13px;
        font-weight:600;
        color:#eee;
      }

      .level-badge {
        display:inline-flex;
        align-items:center;
        gap:6px;
        font-size:12px;
        font-weight:700;
        text-transform:capitalize;
        color:#fff;
        background:#1a1a1a;
        border:0.5px solid #2a2a2a;
        padding:5px 12px;
        border-radius:8px;
      }

      .level-bars {
        display:flex;
        gap:2px;
        align-items:flex-end;
      }

      .level-bars span {
        width:3px;
        border-radius:2px;
        background:#3a3a3a;
      }

      .level-bars span:nth-child(1) { height:6px; }
      .level-bars span:nth-child(2) { height:9px; }
      .level-bars span:nth-child(3) { height:12px; }

      .level-badge.advanced .level-bars span {
        background:#e0574a;
      }

