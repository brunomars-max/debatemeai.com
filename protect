<!DOCTYPE html>
<html>
  <head>
    <title>Hello, World!</title>
    <link rel="stylesheet" href="styles.css" />
    <style>
      div {
        width: 400px;
        height: 100px;
        border: 2px solid green
      }
    </style>
  </head>
  <body>
      <button id="recordbtn">record</button>
      <button id="stopbtn">stop</button>

      <div id="soundscontainer">
          <audio controls id="audioItem"></audio>
      </div>


      <script>
        let recordbtn=document.getElementById("recordbtn")
        let stopbtn=document.getElementById("stopbtn")
        let chunks = [] //will contain the audio
        let mediarecorder = ""


        //check for audio support
        if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
        console.log("getUserMedia supported.");
        navigator.mediaDevices
          .getUserMedia(
            // constraints - only audio needed for this app
            {
              audio: true,
            },
          )

          // Success callback
          .then(preparecapture)

          // Error callback
          .catch((err) => {
            console.error(`The following getUserMedia error occurred: ${err}`);
          });
      } else {
        console.log("getUserMedia not supported on your browser!");
      }


      function  preparecapture( stream )
      {
           mediarecorder = new MediaRecorder(stream)
           mediarecorder.addEventListener("dataavailable", savechunk)
          mediarecorder.addEventListener("stop", showAudio)
      }

      function savechunk( info )
      {
        chunks.push(info.data)
      }

      function startrecord()
      {
        mediarecorder.start()
        console.log(mediarecorder.state); //expect it to show recording
        console.log("started to record")
        recordbtn.style.background = "green"

        

      }

      function showAudio()
      {
        console.log("showing audio")
  
 


        let audio = document.getElementById("audioItem")
        let blob = new Blob(chunks, {type: "audio/ogg; codecs=opus"})
        chunks=[]
        let audiolink = window.URL.createObjectURL(blob)

        audio.src = audiolink


      }




      function stoprecord()
      {
        mediarecorder.stop()
        console.log(mediarecorder.state); //expect it to show stopped recording
        console.log("stoppedrecording")
        recordbtn.style.background = "red"
      }
      
      recordbtn.addEventListener("click", startrecord)
      stopbtn.addEventListener("click", stoprecord)


      </script>









  </body>
</html>

