      .ticket-top {
        padding:30px 32px 26px;
        text-align:center;
      }

      .kicker {
        font-size:11px;
        text-transform:uppercase;
        letter-spacing:1.5px;
        color:#e0857a;
        margin-bottom:14px;
      }

